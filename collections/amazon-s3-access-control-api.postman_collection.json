        {
          "id": "9030be6c-f967-4a78-b549-acecb743a592",
          "name": "Amazon S3 Put Bucket Acl",
          "request": {
            "name": "Amazon S3 Put Bucket Acl",
            "description": {
              "content": "Sets the permissions on an existing bucket using access control lists (ACL). You can set permissions to grant or revoke access at the bucket level using either the request body or request headers.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "{{Bucket}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "acl",
                  "value": "null"
                }
              ],
              "variable": [
                {
                  "description": "AWS region (This can only be one of us-east-1,us-east-2,us-west-1,us-west-2,eu-west-1,eu-west-2,eu-west-3,eu-central-1,eu-north-1,ap-northeast-1,ap-northeast-2,ap-southeast-1,ap-southeast-2,ap-south-1,sa-east-1,ca-central-1)",
                  "type": "any",
                  "value": "{{region}}",
                  "key": "region"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "The canned ACL to apply to the bucket.",
                "key": "x-amz-acl",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Allows grantee full control of the bucket.",
                "key": "x-amz-grant-full-control",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Allows grantee to list the objects in the bucket.",
                "key": "x-amz-grant-read",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Allows grantee to read the bucket ACL.",
                "key": "x-amz-grant-read-acp",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Allows grantee to create objects in the bucket.",
                "key": "x-amz-grant-write",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Allows grantee to write the ACL for the applicable bucket.",
                "key": "x-amz-grant-write-acp",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "The base64-encoded 128-bit MD5 digest of the data.",
                "key": "Content-MD5",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "The account ID of the expected bucket owner.",
                "key": "x-amz-expected-bucket-owner",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/xml"
              },
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<AccessControlPolicy xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\">\n  <Owner>\n    <DisplayName>(string)</DisplayName>\n    <ID>(string)</ID>\n  </Owner>\n  <AccessControlList>\n    <Grant>\n      <Grantee>\n        <DisplayName>(string)</DisplayName>\n        <EmailAddress>(string)</EmailAddress>\n        <ID>(string)</ID>\n        <Type>(string)</Type>\n        <URI>(string)</URI>\n      </Grantee>\n      <Permission>(string)</Permission>\n    </Grant>\n    <Grant>\n      <Grantee>\n        <DisplayName>(string)</DisplayName>\n        <EmailAddress>(string)</EmailAddress>\n        <ID>(string)</ID>\n        <Type>(string)</Type>\n        <URI>(string)</URI>\n      </Grantee>\n      <Permission>(string)</Permission>\n    </Grant>\n  </AccessControlList>\n</AccessControlPolicy>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          },
          "response": [
            {
              "id": "09134658-c636-441b-9dc0-9a76f13e6f79",
              "name": "Bucket ACL updated successfully.",
