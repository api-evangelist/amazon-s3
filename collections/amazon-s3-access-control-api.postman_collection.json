          "id": "d22110a5-a9d9-456e-b385-8e72de440a19",
          "name": "Amazon S3 Get Bucket Acl",
          "request": {
            "name": "Amazon S3 Get Bucket Acl",
            "description": {
              "content": "This implementation of the GET action uses the acl subresource to return the access control list (ACL) of a bucket. To use GET to return the ACL, you must have the READ_ACP access to the bucket.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "{{Bucket}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "acl",
                  "value": "null"
                }
              ],
              "variable": [
                {
                  "description": "AWS region (This can only be one of us-east-1,us-east-2,us-west-1,us-west-2,eu-west-1,eu-west-2,eu-west-3,eu-central-1,eu-north-1,ap-northeast-1,ap-northeast-2,ap-southeast-1,ap-southeast-2,ap-south-1,sa-east-1,ca-central-1)",
                  "type": "any",
                  "value": "{{region}}",
                  "key": "region"
