                  {
                    "disabled": false,
                    "description": "The account ID of the expected bucket owner.",
                    "key": "x-amz-expected-bucket-owner",
                    "value": "example_value"
                  }
                ],
                "method": "PUT",
                "body": {
                  "mode": "raw",
                  "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<AccessControlPolicy>\n  <Owner>\n    <DisplayName>example_value</DisplayName>\n    <ID>abc123</ID>\n  </Owner>\n  <AccessControlList>\n    <Grant/>\n  </AccessControlList>\n</AccessControlPolicy>",
                  "options": {
                    "raw": {
                      "language": "xml"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
