        {
          "id": "c451114a-a3e7-4cda-a4b8-3256d129d508",
          "name": "Amazon S3 Put Bucket Tagging",
          "request": {
            "name": "Amazon S3 Put Bucket Tagging",
            "description": {
              "content": "Sets the tags for a bucket. Use tags to organize your AWS bill to reflect your own cost structure. To use this operation, you must have permission to perform the s3:PutBucketTagging action.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "{{Bucket}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "tagging",
                  "value": "null"
                }
              ],
              "variable": [
                {
                  "description": "AWS region (This can only be one of us-east-1,us-east-2,us-west-1,us-west-2,eu-west-1,eu-west-2,eu-west-3,eu-central-1,eu-north-1,ap-northeast-1,ap-northeast-2,ap-southeast-1,ap-southeast-2,ap-south-1,sa-east-1,ca-central-1)",
                  "type": "any",
                  "value": "{{region}}",
                  "key": "region"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "The base64-encoded 128-bit MD5 digest of the data.",
                "key": "Content-MD5",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "The account ID of the expected bucket owner.",
                "key": "x-amz-expected-bucket-owner",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Algorithm used to create the checksum.",
                "key": "x-amz-checksum-algorithm",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/xml"
              },
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Tagging xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\">\n  <TagSet>\n    <Tag>\n      <Key>(string)</Key>\n      <Value>(string)</Value>\n    </Tag>\n    <Tag>\n      <Key>(string)</Key>\n      <Value>(string)</Value>\n    </Tag>\n  </TagSet>\n</Tagging>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          },
