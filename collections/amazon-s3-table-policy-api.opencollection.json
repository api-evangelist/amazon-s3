              {
                "name": "tableBucketARN",
                "value": "",
                "type": "path",
                "description": "The Amazon Resource Name (ARN) of the table bucket."
              }
            ]
          },
          "docs": "Deletes a table bucket policy for a table bucket."
        },
        {
          "info": {
            "name": "Amazon S3 Get Table Policy",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://s3-control.{region}.amazonaws.com/tables/:tableBucketARN/:namespace/:name/policy",
            "params": [
              {
                "name": "tableBucketARN",
                "value": "",
                "type": "path",
                "description": "The Amazon Resource Name (ARN) of the table bucket."
              },
              {
                "name": "namespace",
                "value": "",
                "type": "path",
                "description": "The name of the namespace."
              },
              {
                "name": "name",
                "value": "Example Title",
                "type": "path",
                "description": "The name of the table."
              }
            ]
          },
          "docs": "Gets the resource policy for a table."
        },
        {
          "info": {
            "name": "Amazon S3 Put Table Policy",
