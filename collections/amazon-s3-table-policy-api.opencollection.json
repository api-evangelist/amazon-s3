            "name": "Amazon S3 Get Table Bucket Policy",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://s3-control.{region}.amazonaws.com/buckets/:tableBucketARN/policy",
            "params": [
              {
                "name": "tableBucketARN",
                "value": "",
                "type": "path",
                "description": "The Amazon Resource Name (ARN) of the table bucket."
              }
            ]
          },
          "docs": "Gets details about a table bucket policy. Returns the policy document associated with the specified table bucket."
        },
        {
          "info": {
            "name": "Amazon S3 Put Table Bucket Policy",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://s3-control.{region}.amazonaws.com/buckets/:tableBucketARN/policy",
            "params": [
              {
                "name": "tableBucketARN",
                "value": "",
                "type": "path",
                "description": "The Amazon Resource Name (ARN) of the table bucket."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates or replaces a table bucket policy for a table bucket."
        },
        {
          "info": {
            "name": "Amazon S3 Delete Table Bucket Policy",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://s3-control.{region}.amazonaws.com/buckets/:tableBucketARN/policy",
