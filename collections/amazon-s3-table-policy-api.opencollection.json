{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amazon S3 Control Access Control Table Policy API",
    "version": "2018-08-20"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
